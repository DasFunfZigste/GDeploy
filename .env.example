# Optional settings: a fresh install starts without .env (Compose >=2.24).
# Keep both credential settings absent/empty for automatic setup. GDeploy saves
# a unique random encryption key and initial account in /data/bootstrap.json.
# Fresh login: admin / admin. First sign-in requires a new username and password.
# The chosen account is saved in the database; these bootstrap values stay unchanged.
# Existing installations keep their current credentials; this does not reset them.
# To use explicit credentials on a NEW volume, run python3 scripts/configure.py
# before first start instead (same admin/admin first login). Preserve its .env/key.
# Never overwrite an existing .env with this example or replace an existing key.
GDEPLOY_SECRET_KEY=
GDEPLOY_ADMIN_USERNAME=admin
GDEPLOY_ADMIN_PASSWORD_HASH=
# false is for the default loopback-only HTTP binding. Set true behind HTTPS.
GDEPLOY_COOKIE_SECURE=false
# For an HTTPS proxy: set COOKIE_SECURE=true and restrict this to its address.
FORWARDED_ALLOW_IPS=127.0.0.1
GDEPLOY_DATA_DIR=/data
GDEPLOY_UBUNTU_ISO=/media/ubuntu.iso
# Add the SHA-256 of your publisher-verified media before provisioning.
GDEPLOY_UBUNTU_SHA256=
GDEPLOY_SPLUNK_PACKAGE=/media/splunk.tgz
GDEPLOY_SPLUNK_SHA256=
GDEPLOY_OS_TIMEOUT=3600
