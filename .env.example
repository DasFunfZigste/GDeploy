# Optional settings: a fresh install starts without .env (Compose >=2.24).
# Keep both credential settings absent/empty for automatic setup. GDeploy saves
# a unique random encryption key and initial account in /data/bootstrap.json.
# Fresh login: admin / admin. First sign-in requires a new username and password.
# The chosen account is saved in the database; these bootstrap values stay unchanged.
# Existing installations keep their current credentials; this does not reset them.
# To use explicit credentials on a NEW volume, run python3 scripts/configure.py
# before first start instead (same admin/admin first login). Preserve its .env/key.
# Never overwrite an existing .env with this example or replace an existing key.
GDEPLOY_SECRET_KEY=
GDEPLOY_ADMIN_USERNAME=admin
GDEPLOY_ADMIN_PASSWORD_HASH=
# Compose defaults to all host IPv4 interfaces for immediate LAN access.
# Optionally restrict to a specific LAN IP or 127.0.0.1 for local access/an SSH tunnel.
# Existing explicit .env values override the default and remain in effect.
# Edit existing settings in place, then: docker compose up -d --force-recreate --wait
GDEPLOY_BIND_IP=0.0.0.0
GDEPLOY_PORT=8000
# false is for direct HTTP (local or LAN). Set true behind HTTPS.
GDEPLOY_COOKIE_SECURE=false
# For an HTTPS proxy: set COOKIE_SECURE=true and restrict this to its address.
FORWARDED_ALLOW_IPS=127.0.0.1
GDEPLOY_DATA_DIR=/data
# Prefer Setup → OS installation media to choose ESXi datastore media,
# upload a file, or select GDeploy server media and verify its checksum.
# ESXi imports use the saved host credentials and retain a copy in /data/media.
# These optional values are the fallback until a media selection is saved in Setup.
# The legacy GDEPLOY_UBUNTU_ISO / GDEPLOY_UBUNTU_SHA256 names still work.
# If both names are provided, the GDEPLOY_OS_* values take precedence.
# Current automated installer support: Ubuntu Server 24.04 LTS amd64 live-server.
GDEPLOY_OS_ISO=/media/ubuntu.iso
# Use the SHA-256 from the publisher's verified checksum list.
GDEPLOY_OS_SHA256=
GDEPLOY_SPLUNK_PACKAGE=/media/splunk.tgz
GDEPLOY_SPLUNK_SHA256=
GDEPLOY_OS_TIMEOUT=3600
